<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameUI/Leaderboard/table.uss?fileID=7433441132597879392&amp;guid=ae0f7f1b297840a4f85f4c14cf0a086f&amp;type=3#table"/>
    <ui:VisualElement name="root" class="scoreboard-root">
        <ui:VisualElement class="score-table">
            <ui:Label text="SCOREBOARD" class="scoreboard-title" />
            <ui:Label text="Hold TAB" class="scoreboard-hint" />
            <ui:VisualElement class="table-header">
                <ui:Label text="#" class="header-cell header-rank" />
                <ui:Label text="Player" class="header-cell header-name" />
                <ui:Label text="K" class="header-cell header-stat" />
                <ui:Label text="D" class="header-cell header-stat" />
                <ui:Label text="K/D" class="header-cell header-stat" />
            </ui:VisualElement>
            <ui:ListView name="score-items" virtualization-method="DynamicHeight" fixed-item-height="28" class="score-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
